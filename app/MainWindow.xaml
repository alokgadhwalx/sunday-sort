<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SundaySort" Width="1080" Height="720" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Card -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18,16"/>
    </Style>

    <!-- Text styles -->
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Big" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Surface2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="{DynamicResource DangerText}"/>
    </Style>
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sidebar navigation -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="12,9">
              <Grid>
                <Border x:Name="pip" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Accent}"
                        HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Collapsed"/>
                <ContentPresenter/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Surface2}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface2}"/>
                <Setter TargetName="pip" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- On/off switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{DynamicResource SubText}" Background="Transparent">
              <Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource SubText}"
                       HorizontalAlignment="Left" Margin="4,0,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="knob" Property="Fill" Value="{DynamicResource OnAccent}"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="track" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Checkbox in lists -->
    <Style x:Key="Tick" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="box" Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{DynamicResource SubText}" Background="Transparent">
              <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                         Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Selectable rows (History) -->
    <Style x:Key="Rows" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,8" Margin="0,1">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Surface2}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= Sidebar ================= -->
    <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,18,14,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
          <Image x:Name="Logo" Width="28" Height="28"/>
          <TextBlock Text="SundaySort" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="19" FontWeight="SemiBold"
                     Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="LiveDot" Width="9" Height="9" Fill="{DynamicResource SubText}" VerticalAlignment="Center"/>
              <TextBlock x:Name="LiveLabel" Text="Checking…" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="LiveHint" Style="{StaticResource Sub}" FontSize="12" Margin="17,2,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel>
          <RadioButton x:Name="NavDash" Style="{StaticResource Nav}" GroupName="nav" IsChecked="True">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE80F;" VerticalAlignment="Center"/><TextBlock Text="Dashboard" Margin="12,0,0,0"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavClean" Style="{StaticResource Nav}" GroupName="nav">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE74D;" VerticalAlignment="Center"/><TextBlock Text="Clean up" Margin="12,0,0,0"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavHistory" Style="{StaticResource Nav}" GroupName="nav">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE81C;" VerticalAlignment="Center"/><TextBlock Text="History" Margin="12,0,0,0"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" GroupName="nav">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE713;" VerticalAlignment="Center"/><TextBlock Text="Settings" Margin="12,0,0,0"/></StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================= Pages ================= -->
    <Grid Grid.Column="1">

      <!-- Status bar for messages -->
      <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18" Panel.ZIndex="10"
              Background="{DynamicResource Text}" CornerRadius="8" Padding="16,10" Visibility="Collapsed">
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource Bg}" FontSize="13"/>
      </Border>

      <!-- ===== Dashboard ===== -->
      <ScrollViewer x:Name="PageDash" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,32">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="OpenDownloads" Style="{StaticResource Btn}" Margin="0,0,8,0">Open folder</Button>
              <Button x:Name="SortNow" Style="{StaticResource Primary}">Sort now</Button>
            </StackPanel>
            <StackPanel>
              <TextBlock Style="{StaticResource H1}" Text="Your Downloads"/>
              <TextBlock x:Name="DownloadsPath" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
            </StackPanel>
          </DockPanel>

          <UniformGrid Columns="4" Margin="-6,22,-6,0">
            <Border Style="{StaticResource Card}" Margin="6">
              <StackPanel>
                <TextBlock Style="{StaticResource Sub}" Text="Waiting to sort"/>
                <TextBlock x:Name="CardLoose" Style="{StaticResource Big}" Text="–"/>
                <TextBlock x:Name="CardLooseSub" Style="{StaticResource Sub}" Text="loose files"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6">
              <StackPanel>
                <TextBlock Style="{StaticResource Sub}" Text="Sorted so far"/>
                <TextBlock x:Name="CardSorted" Style="{StaticResource Big}" Text="–"/>
                <TextBlock x:Name="CardSortedSub" Style="{StaticResource Sub}" Text=""/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6">
              <StackPanel>
                <TextBlock Style="{StaticResource Sub}" Text="Could be freed"/>
                <TextBlock x:Name="CardFree" Style="{StaticResource Big}" Text="–" Foreground="{DynamicResource AccentText}"/>
                <Button x:Name="CardFreeLink" Style="{StaticResource Link}" HorizontalAlignment="Left">
                  <TextBlock x:Name="CardFreeSub" FontSize="13" Text="Scan now →"/>
                </Button>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6">
              <StackPanel>
                <TextBlock Style="{StaticResource Sub}" Text="Live sorting"/>
                <TextBlock x:Name="CardLive" Style="{StaticResource Big}" Text="–"/>
                <TextBlock x:Name="CardLiveSub" Style="{StaticResource Sub}" Text=""/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Where your downloads come from"/>
                <TextBlock x:Name="SourcesNote" Style="{StaticResource Sub}" Text="Reading download sources…" Margin="0,-4,0,12"/>
                <ItemsControl x:Name="SourcesList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="150"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                        <Border Grid.Column="1" Height="10" CornerRadius="5" Background="{DynamicResource Surface2}" VerticalAlignment="Center">
                          <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="5" Background="{DynamicResource Accent}"/>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding CountText}" HorizontalAlignment="Right" FontSize="13" Foreground="{DynamicResource SubText}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Recent activity"/>
                <TextBlock x:Name="RecentEmpty" Style="{StaticResource Sub}" Text="Nothing sorted yet." Visibility="Collapsed"/>
                <ItemsControl x:Name="RecentList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SubText}" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- ===== Clean up ===== -->
      <Grid x:Name="PageClean" Margin="32,26,32,24" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <Button x:Name="ScanNow" DockPanel.Dock="Right" Style="{StaticResource Btn}" VerticalAlignment="Center">Scan again</Button>
          <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Clean up"/>
            <TextBlock x:Name="CleanSummary" Style="{StaticResource Sub}" Margin="0,2,0,0"
                       Text="Old installers for apps you already have, zip files you've already unzipped, and duplicates. Nothing is deleted until you choose."/>
          </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,14" Padding="8,8">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="10,4,10,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="3*"/>
              </Grid.ColumnDefinitions>
              <CheckBox x:Name="SelectAll" Style="{StaticResource Tick}"/>
              <TextBlock Grid.Column="1" Text="File" Style="{StaticResource Sub}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="2" Text="Kind" Style="{StaticResource Sub}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="3" Text="Size" Style="{StaticResource Sub}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="4" Text="Why it's probably safe to delete" Style="{StaticResource Sub}" FontWeight="SemiBold"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="CleanEmpty" Style="{StaticResource Sub}" Margin="12,12" Visibility="Collapsed"/>
                <ItemsControl x:Name="CleanList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,9">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="3*"/>
                          </Grid.ColumnDefinitions>
                          <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding Selected, Mode=TwoWay}" Tag="row"/>
                          <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                            <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource SubText}"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="13" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="13" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="4" Text="{Binding Reason}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource SubText}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <DockPanel Grid.Row="2">
          <Button x:Name="RecycleSelected" DockPanel.Dock="Right" Style="{StaticResource Primary}" IsEnabled="False">Move to Recycle Bin</Button>
          <TextBlock x:Name="SelectedText" Style="{StaticResource Sub}" VerticalAlignment="Center"
                     Text="Ticked files go to the Recycle Bin, so you can restore them."/>
        </DockPanel>
      </Grid>

      <!-- ===== History ===== -->
      <Grid x:Name="PageHistory" Margin="32,26,32,24" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="History"/>
          <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,0" Text="Every sort is logged. Pick one to see what moved and why, or undo it."/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="6">
            <Grid>
              <TextBlock x:Name="HistoryEmpty" Style="{StaticResource Sub}" Margin="12" Text="Nothing sorted yet." Visibility="Collapsed"/>
              <ListBox x:Name="RunList" Style="{StaticResource Rows}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                      <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource SubText}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,10">
                <Button x:Name="UndoRun" DockPanel.Dock="Right" Style="{StaticResource Btn}" IsEnabled="False">Undo this sort</Button>
                <TextBlock x:Name="RunTitle" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" Text="Pick a sort on the left"/>
              </DockPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MoveList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="2,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.6*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,0,10,0"/>
                          <TextBlock Grid.Column="1" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,0,10,0"/>
                          <TextBlock Grid.Column="2" Text="{Binding Reason}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource SubText}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- ===== Settings ===== -->
      <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="32,26,32,32" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Style="{StaticResource H1}" Text="Settings"/>
          <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,18" Text="Changes apply straight away to the background sorting."/>

          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <DockPanel>
              <CheckBox x:Name="SetLive" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Live sorting" FontWeight="SemiBold"/>
                <TextBlock x:Name="SetLiveSub" Style="{StaticResource Sub}" Text="Sort new downloads about 2 minutes after they finish, instead of only on Sundays."/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <DockPanel>
              <CheckBox x:Name="SetSource" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Sort by website" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Sub}" Text="Files from WhatsApp, Gmail, Google Drive, Discord and other well-known sites go into their own 'From …' folders."/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <DockPanel>
              <CheckBox x:Name="SetWeekly" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Sunday check-up" FontWeight="SemiBold"/>
                <TextBlock x:Name="SetWeeklySub" Style="{StaticResource Sub}" Text="Every Sunday: sort anything left over and look for space you could free."/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <DockPanel>
              <Button x:Name="EditRules" DockPanel.Dock="Right" Style="{StaticResource Btn}" VerticalAlignment="Center">Edit rules</Button>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Your rules" FontWeight="SemiBold"/>
                <TextBlock x:Name="RulesSub" Style="{StaticResource Sub}" Text="Send files to your own folders by name (e.g. *invoice* → Finance), by website, or by type."/>
              </StackPanel>
            </DockPanel>
          </Border>

          <TextBlock Style="{StaticResource H2}" Text="Folders" Margin="0,18,0,10"/>
          <WrapPanel>
            <Button x:Name="OpenLogs" Style="{StaticResource Btn}" Margin="0,0,8,8">Open logs and reports</Button>
            <Button x:Name="OpenInstall" Style="{StaticResource Btn}" Margin="0,0,8,8">Open install folder</Button>
          </WrapPanel>

          <TextBlock Style="{StaticResource H2}" Text="About" Margin="0,18,0,6"/>
          <TextBlock x:Name="AboutText" Style="{StaticResource Sub}"/>
          <WrapPanel Margin="0,10,0,0">
            <Button x:Name="OpenRepo" Style="{StaticResource Btn}" Margin="0,0,8,8">Project page</Button>
            <Button x:Name="UninstallBtn" Style="{StaticResource Danger}" Margin="0,0,8,8">Uninstall SundaySort…</Button>
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
